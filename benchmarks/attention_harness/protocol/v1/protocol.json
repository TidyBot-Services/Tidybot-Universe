{
  "protocol_id": "tidybot-attentionbench-robosuite-v1",
  "status": "d7_frozen",
  "tasks": {
    "cube_lift": {
      "robosuite_env": "Lift",
      "goal": "Lift the cube clear of the table."
    },
    "cube_stack": {
      "robosuite_env": "Stack",
      "goal": "Place cube A on top of cube B."
    }
  },
  "runtime_versions": {
    "robosuite": "1.5.1",
    "mujoco": "3.3.0",
    "numpy": "1.26.4"
  },
  "models": {
    "developer": {
      "model": "parcc/GLM",
      "temperature": 0.0,
      "reasoning_effort": "low",
      "max_tokens": 2048,
      "max_invalid_program_retries": 2
    },
    "artifact_reviewer": {
      "model": "parcc/Qwen",
      "authoritative": false,
      "max_tokens": 384
    },
    "advisor_proxy": {
      "model": "parcc/Qwen",
      "temperature": 0.0,
      "prompt_source": "benchmarks/attention_harness/advisor_proxy.py",
      "response_cache_required": true,
      "oracle_fields_allowed": false
    }
  },
  "evaluation": {
    "authoritative_success": "Robosuite native _check_success",
    "policy_timeout_seconds": 90,
    "codegen_timeout_seconds": 240,
    "review_timeout_seconds": 180,
    "heldout_model_calls_allowed": false
  },
  "schemas": {
    "reference_episode": "attentionbench.episode.v1",
    "model_episode": "attentionbench.parcc_episode.v1",
    "evaluator_probes": "attentionbench.evaluator-probes.v1",
    "evaluator_parity": "attentionbench.evaluator-parity.v1",
    "public_policy_validation": "attentionbench.public-policy-validation.v1",
    "freeze_manifest": "attentionbench.freeze-manifest.v1"
  },
  "sdk": {
    "modules": ["sensors", "arm", "gripper"],
    "shared_sdk": "tidybot_sdk.TidyBotSDK",
    "backend_contract": "tidybot_sdk.RobotBackend",
    "sensor_methods": ["get_observation", "pixel_to_world"],
    "optional_capabilities": {
      "find_objects": {
        "contract": "tidybot_sdk.ObjectPerceptionBackend",
        "robosuite_enabled": false,
        "reason": "requires a future non-oracle RGB-D perception service"
      }
    },
    "observation": {
      "camera_rgb": "<camera>_image",
      "camera_depth_meters": "<camera>_depth",
      "camera_pixel_origin": "opencv_top_left",
      "camera_intrinsics": "<camera>_intrinsics",
      "camera_to_control_frame": "<camera>_pose_mat",
      "proprioception": "robot0_*"
    },
    "object_oracle_visible": false,
    "generated_process_receives_credentials": false
  },
  "reference_policy": {
    "source": "robosuite_sim/reference_policy.py",
    "privileged": true,
    "role": "infrastructure validation only",
    "success_gate": "at least 4/5 per task"
  },
  "assistance_modes": {
    "benchmark_proxy": {
      "primary_responder": "advisor_proxy",
      "human_allowed": false,
      "fixed_proxy_latency_seconds": 2.0,
      "logical_cost_per_response": 1,
      "primary_ranking_eligible": true
    },
    "live_human_first": {
      "primary_responder": "human",
      "human_deadline_seconds": 60.0,
      "fallback_responder": "advisor_proxy",
      "primary_ranking_eligible": false,
      "role": "deployment and case-study validation only"
    },
    "locked_after_run_start": true,
    "contract_source": "benchmarks/attention_harness/attention_modes.py"
  },
  "formal_task_policies": {
    "status": "frozen",
    "source_directory": "benchmarks/attention_harness/protocol/v1/policies",
    "observation_boundary": "public RGB-D, camera calibration, and proprioception only",
    "development_gate": "25/25 native successes per task",
    "validation_evidence": "benchmarks/attention_harness/protocol/v1/evidence/public_policy_dev_report.json",
    "heldout_eligible": true
  },
  "primary_experiment": {
    "ready": false,
    "reason": "the seven Attention-System policies and full RoboCasa matrix belong to the next stage"
  },
  "heldout_ready": true
}
